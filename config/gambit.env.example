# Copy this file to config/gambit.env and edit the absolute paths.

# GAMBIT source root. Run the Glean indexer from this directory so source paths
# in the database are relative to the GAMBIT checkout.
GAMBIT_SOURCE_DIR=/absolute/path/to/gambit

# Existing CMake build directory for GAMBIT.
GAMBIT_BUILD_DIR=/absolute/path/to/gambit/build

# Local-only Glean database and query output.
GLEAN_DB_ROOT=.glean/db
GLEAN_DB_NAME=cbs
GLEAN_DB_INSTANCE=0

# Number of concurrent indexer processes. Reduce this if memory is limited.
GLEAN_JOBS=4

# Optional executable overrides.
# GLEAN_BIN=glean
# CLANG_INDEX_BIN=clang-index
# CLANG_DERIVE_BIN=clang-derive
